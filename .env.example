# Browser login username is admin. Generate with: openssl rand -base64 32
APP_PASSWORD=
# Set to the public HTTPS origin when running behind a reverse proxy.
APP_ORIGIN=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DEEPL_API_KEY=

# Single persistent Node process only. Counters reset on restart.
# For serverless/multiple replicas, leave this blank and configure Redis below.
RATE_LIMIT_STORE=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
