{
  "manifest_version": 3,
  "name": "JevCSAssistant",
  "version": "0.2.0",
  "description": "Jev: triaż, zamówienia, wycena i dostępność. Wzorce odpowiedzi i drafty Gmaila.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "tabs",
    "alarms",
    "notifications",
    "sidePanel"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://openrouter.ai/*",
    "https://calendar.google.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "JevCSAssistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_page": "options.html",
  "optional_host_permissions": [
    "https://chat-csa.vercel.app/*"
  ]
}
